{
  "name": "orrery",
  "version": "0.12.2",
  "private": true,
  "description": "Architecture, system design and business flow diagrams with official AWS, Azure, Google Cloud, Kubernetes, GitHub and IBM icons, auto-laid out and rendered to SVG, PNG, draw.io, React TSX and HTML.",
  "license": "MIT",
  "author": "Sagar Gupta (https://github.com/Sagargupta16)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sagargupta16/orrery.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync-icons": "node scripts/sync-icons.mjs",
    "gallery": "node scripts/gallery.mjs",
    "check": "node scripts/check-repo.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@iconify-json/carbon": "1.2.29",
    "@iconify-json/logos": "1.2.18",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/simple-icons": "1.2.101",
    "@iconify-json/tabler": "1.2.43",
    "@primer/octicons": "19.42.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/node": "26.6.6",
    "elkjs": "0.12.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "simple-icons": "16.36.0",
    "svgo": "4.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
